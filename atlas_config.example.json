{
  "root_folder": ".",
  "excluded_folder_names": [
    "node_modules",
    ".git",
    "__pycache__",
    "$RECYCLE.BIN",
    "System Volume Information",
    ".vs",
    "env",
    ".venv",
    "venv"
  ],
  "excluded_paths": [
    "C:\\Windows",
    "C:\\ProgramData",
    "C:\\Program Files",
    "C:\\Program Files (x86)"
  ],
  "excluded_file_patterns": [
    "Thumbs.db",
    "desktop.ini",
    "~$*",
    "*.tmp",
    "*.log"
  ]
}